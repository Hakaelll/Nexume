{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexume",
  "version": "0.8.1",
  "identifier": "app.nexume.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --configLoader native --host 127.0.0.1 --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build --configLoader native",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexume",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#f6f2ee",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; connect-src 'self' ipc: http://ipc.localhost https://graphql.anilist.co https://*.supabase.co https://s4.anilist.co https://s.anilist.co https://*.anilist.co; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/images/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nexume Contributors",
    "category": "Entertainment",
    "shortDescription": "Your anime, remembered.",
    "longDescription": "A local-first anime library with a spatial Three.js collection, personal reviews, lists and optional sharing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}
